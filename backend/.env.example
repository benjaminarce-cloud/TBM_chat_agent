ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tbm_chat
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
WIDGET_TOKEN_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SALT=replace-with-a-separate-random-secret
ALLOWED_WIDGET_ORIGINS=http://localhost:3000
ALLOWED_PARENT_ORIGINS=http://localhost:3000

# Resend is the pilot adapter. TBM must approve the inbox and sender before production.
RESEND_API_KEY=
HANDOFF_FROM_EMAIL=
HANDOFF_TO_EMAIL=
ADMIN_ALERT_EMAIL=

# PILOT DEFAULTS ONLY — TBM must approve exact limits before production.
SESSION_MESSAGE_CAP=20
IP_RATE_LIMIT_CAPACITY=30
IP_RATE_LIMIT_REFILL_PER_MINUTE=10
SESSION_RATE_LIMIT_CAPACITY=10
SESSION_RATE_LIMIT_REFILL_PER_MINUTE=5

# No alert is sent until both the relevant threshold and admin email are configured.
DAILY_SESSION_ALERT_THRESHOLD=
DAILY_SPEND_ALERT_USD=

# Pricing is used only to estimate alert telemetry, never to quote a visitor.
SONNET_INPUT_COST_PER_MILLION=
SONNET_OUTPUT_COST_PER_MILLION=
HAIKU_INPUT_COST_PER_MILLION=
HAIKU_OUTPUT_COST_PER_MILLION=
