ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tbm_chat
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
COMPUTER_USE_ENABLED=false
COMPUTER_USE_MODEL=gpt-5.6
COMPUTER_USE_API_TOKEN=
# Exact hostnames only; do not use a wildcard for production.
COMPUTER_USE_ALLOWED_DOMAINS=localhost
COMPUTER_USE_MAX_STEPS=8
COMPUTER_USE_MAX_OUTPUT_TOKENS=1000
COMPUTER_USE_TIMEOUT_SECONDS=90
COMPUTER_USE_MAX_CONCURRENCY=1
COMPUTER_USE_RATE_LIMIT_CAPACITY=3
COMPUTER_USE_RATE_LIMIT_REFILL_PER_MINUTE=0.5
WIDGET_TOKEN_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SALT=replace-with-a-separate-random-secret
ALLOWED_WIDGET_ORIGINS=http://localhost:3000
ALLOWED_PARENT_ORIGINS=http://localhost:3000
PRIVACY_NOTICE_VERSION=pilot-draft-2026-07-17
PRIVACY_NOTICE_ES="Este piloto de TBM Carriers recopila los mensajes que escribas y, si los proporcionas, tu nombre, correo electrónico, teléfono, empresa, origen y destino para calificar una solicitud y dar seguimiento. También registra datos técnicos mínimos para seguridad y medición del piloto. Al aceptar, tus mensajes pueden enviarse a proveedores de IA y correo y almacenarse en servicios de nube, incluso en Estados Unidos u otros países. No compartas contraseñas, documentos ni información sensible. Los mensajes se conservan hasta 90 días; los datos de leads no capturados hasta 90 días y los leads capturados hasta 365 días. Puedes retirar tu consentimiento o solicitar acceso, rectificación, cancelación u oposición contactando al administrador del piloto. Responsable: TBM Carriers. Borrador para prueba interna; requiere revisión legal antes de cualquier uso público."
PRIVACY_NOTICE_EN="This TBM Carriers pilot collects the messages you write and, if you provide them, your name, email, phone, company, origin, and destination to qualify a request and follow up. It also records limited technical data for security and pilot measurement. If you accept, your messages may be sent to AI and email providers and stored in cloud services, including in the United States or other countries. Do not share passwords, documents, or sensitive information. Messages are kept for up to 90 days; uncaptured lead data for up to 90 days; and captured leads for up to 365 days. You may withdraw consent or request access, correction, deletion, or objection by contacting the pilot administrator. Data controller: TBM Carriers. Internal pilot draft; legal review is required before any public use."
# Uvicorn trusts forwarding headers only from these proxy IPs/CIDRs. Configure this for the host.
FORWARDED_ALLOW_IPS=127.0.0.1

# Resend is the pilot adapter. TBM must approve the inbox and sender before production.
RESEND_API_KEY=
HANDOFF_FROM_EMAIL=
HANDOFF_TO_EMAIL=
ADMIN_ALERT_EMAIL=

# PILOT DEFAULTS ONLY — TBM must approve exact limits before production.
SESSION_MESSAGE_CAP=20
IP_RATE_LIMIT_CAPACITY=30
IP_RATE_LIMIT_REFILL_PER_MINUTE=10
SESSION_RATE_LIMIT_CAPACITY=10
SESSION_RATE_LIMIT_REFILL_PER_MINUTE=5
CONSENT_RATE_LIMIT_CAPACITY=5
CONSENT_RATE_LIMIT_REFILL_PER_MINUTE=1
FEEDBACK_RATE_LIMIT_CAPACITY=5
FEEDBACK_RATE_LIMIT_REFILL_PER_MINUTE=1

TRANSCRIPT_RETENTION_DAYS=90
UNCAPTURED_RETENTION_DAYS=90
CAPTURED_LEAD_RETENTION_DAYS=365

# No alert is sent until both the relevant threshold and admin email are configured.
DAILY_SESSION_ALERT_THRESHOLD=
DAILY_SPEND_ALERT_USD=

# Pricing is used only to estimate alert telemetry, never to quote a visitor.
SONNET_INPUT_COST_PER_MILLION=
SONNET_OUTPUT_COST_PER_MILLION=
HAIKU_INPUT_COST_PER_MILLION=
HAIKU_OUTPUT_COST_PER_MILLION=
