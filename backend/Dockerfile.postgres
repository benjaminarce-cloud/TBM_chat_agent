FROM postgres:17-alpine3.23@sha256:8189a1f6e40904781fc9e2612687877791d21679866db58b1de996b31fc312e4

# The image runs as postgres, so the root-only gosu privilege helper is unnecessary.
RUN rm /usr/local/bin/gosu
USER postgres

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["pg_isready", "-U", "postgres"]
